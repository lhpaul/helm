{
  "name": "@helm/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc --noEmit && bun build src/index.ts --outdir dist --target bun",
    "test": "vitest run",
    "lint": "eslint src/",
    "sync": "bun run src/scripts/sync.ts"
  },
  "dependencies": {
    "@helm/adapters": "workspace:*",
    "@helm/orchestrator": "workspace:*",
    "@helm/shared": "workspace:*",
    "@helm/storage": "workspace:*",
    "@helm/workflow": "workspace:*",
    "hono": "^4.12.18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "bun-types": "^1.3.13"
  }
}
