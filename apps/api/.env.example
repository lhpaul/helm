# Copy this file to .env and fill in the values for local development.
# Bun reads .env from the working directory of the process (apps/api/),
# so this file lives here — NOT in the repo root.

# Absolute path to the knowledge repo for the active Product.
# This repo contains .helm/product.yaml with the Product configuration.
# Example: /Users/yourname/Git/Helm/helm-knowledge
HELM_KNOWLEDGE_REPO_PATH=
