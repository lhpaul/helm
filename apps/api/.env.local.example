# Copy to `.env.local` (gitignored) and fill in machine-specific values.
# Merged into `.env` by `pnpm sync-env` after 1Password secret injection.

# Knowledge repo for the active Product (contains `.helm/product.yaml`).
HELM_KNOWLEDGE_REPO_PATH=/Users/yourname/Git/Helm/helm-knowledge

# Helm operational data (items, agent-runs, worktrees, …).
HELM_DATA_DIR=/Users/yourname/Git/Helm/helm/apps/api/data

# GitHub PAT for GitHub Projects / repo API. Alternative: `gh auth token`
GITHUB_TOKEN=
