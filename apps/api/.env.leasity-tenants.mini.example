# Arriendo Fácil on the Mac Mini — input file for `pnpm sync-env`.
#
# Copy to apps/api/.env.leasity-tenants on the Mini (same directory, without
# the `.mini.example` suffix), then:
#
#   OP_SERVICE_ACCOUNT_TOKEN=$(cat ~/.config/dev-session/op-service-account.token) \
#     pnpm sync-env -- leasity-tenants
#
# No secret values here: only 1Password references and Mini paths, so this file
# is safe to commit. See the service account section of
# helm-knowledge/operations/arriendo-facil-mac-mini.md (TD-003 / helm#138).

HELM_KNOWLEDGE_REPO_PATH=/Users/lhpaul/Git/Leasity/leasity-tenants-knowledge
HELM_DATA_DIR=/Users/lhpaul/Git/Leasity/helm-data
GITHUB_TOKEN=op://Helm/helm/github-token
LINEAR_API_KEY=op://Leasity/leasity-tenants/linear-api-key
GITHUB_WEBHOOK_SECRET=op://Leasity/leasity-tenants/github-webhook-secret
LINEAR_WEBHOOK_SECRET=op://Leasity/leasity-tenants/linear-webhook-secret

# Once the Mini runs a build with #160 (operator token, ADR-045), add a
# HELM_API_TOKEN line pointing at the Product's Helm API token in 1Password.
# Every /api/* route and the /ws upgrade answer 401 without it.